{
  "name": "@orbital/strapi-plugin-news",
  "version": "1.1.1",
  "description": "Orbital blog news for the Strapi admin homepage",
  "license": "MIT",
  "author": "Orbital",
  "engines": {
    "node": ">=20.0.0"
  },
  "strapi": {
    "name": "orbital-news",
    "displayName": "Orbital News",
    "kind": "plugin",
    "description": "Latest articles from the Orbital blog"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "default": "./dist/admin/index.mjs"
    },
    "./strapi-server": {
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "admin/src",
    "server/src",
    "scripts",
    "tsconfig.json",
    "strapi-server.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/news.test.cjs tests/versioning.test.cjs",
    "typecheck": "tsc --noEmit",
    "prepack": "yarn build",
    "test:access": "node --test tests/access.test.cjs",
    "prepare": "yarn setup:hooks",
    "setup:hooks": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "he": "^1.2.0",
    "sanitize-html": "^2.13.1"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.13.0",
    "@strapi/admin": "^5.13.0",
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0",
    "@types/he": "^1.2.0",
    "@types/sanitize-html": "^2.13.0",
    "@types/react": "^18.0.0",
    "@types/node": "^22.0.0",
    "@strapi/strapi": "5.59.0",
    "@strapi/admin": "5.59.0",
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.0.0",
    "@types/koa": "^2.15.0",
    "dotenv": "^16.4.0",
    "jsonwebtoken": "^9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0rbitaI/orbital-plugin-strapi.git"
  },
  "homepage": "https://github.com/0rbitaI/orbital-plugin-strapi#readme",
  "bugs": {
    "url": "https://github.com/0rbitaI/orbital-plugin-strapi/issues"
  }
}
